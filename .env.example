# Contact form: Resend API key for sending mail
RESEND_API_KEY=
# Contact form: inbox that receives messages
CONTACT_TO_EMAIL=
# Contact form: sender address. Hint: onboarding@resend.dev
CONTACT_FROM_EMAIL=
# Cloudflare Turnstile secret key (server verify). Test: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
# Cloudflare Turnstile site key (public widget). Test: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Activity: GitHub personal access token
GITHUB_TOKEN=
# Activity: GitHub username to read
GITHUB_USERNAME=
# Activity: Spotify app client ID
SPOTIFY_CLIENT_ID=
# Activity: Spotify app client secret
SPOTIFY_CLIENT_SECRET=
# Activity: Spotify refresh token for the owner account
SPOTIFY_REFRESH_TOKEN=
# Activity: Discord user ID to read presence for
DISCORD_USER_ID=

# Optional: public site URL. Default: https://hanseo.tech
# NEXT_PUBLIC_SITE_URL=
# Optional: Spotify now-playing cache seconds. Default: 20
# ACTIVITY_SPOTIFY_REVALIDATE_SECONDS=
# Optional: Spotify details cache seconds. Default: 600
# ACTIVITY_SPOTIFY_DETAILS_REVALIDATE_SECONDS=
# Optional: Spotify top-items cache seconds. Default: 21600
# ACTIVITY_SPOTIFY_TOP_REVALIDATE_SECONDS=
# Optional: Discord cache seconds. Default: 20
# ACTIVITY_DISCORD_REVALIDATE_SECONDS=
